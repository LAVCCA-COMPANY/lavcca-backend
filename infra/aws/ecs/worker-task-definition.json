{
  "family": "natam-worker",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "4096",
  "memory": "16384",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "ephemeralStorage": { "sizeInGiB": 40 },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/NatamWorkerExecutionRole",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/NatamWorkerTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "__ACCOUNT_ID__.dkr.ecr.ap-northeast-2.amazonaws.com/natam-worker:__IMAGE_TAG__",
      "essential": true,
      "stopTimeout": 30,
      "environment": [
        { "name": "MVP_LOGGING", "value": "1" },
        { "name": "USE_LEARNED_DB", "value": "false" },
        { "name": "LEARN_TO_DB", "value": "false" },
        { "name": "GEN_MODEL_FALLBACK", "value": "models/gemini-3.6-flash" },
        { "name": "TRANSCRIBE_FALLBACK", "value": "aws" },
        { "name": "AWS_TRANSCRIBE_S3", "value": "s3://lavcca-dev-customer-uploads/transcribe-tmp/" }
      ],
      "secrets": [
        { "name": "GEMINI_API_KEY",            "valueFrom": "__SECRET_ARN__:GEMINI_API_KEY::" },
        { "name": "NAVER_CLIENT_ID",           "valueFrom": "__SECRET_ARN__:NAVER_CLIENT_ID::" },
        { "name": "NAVER_CLIENT_SECRET",       "valueFrom": "__SECRET_ARN__:NAVER_CLIENT_SECRET::" },
        { "name": "ACRCLOUD_HOST",             "valueFrom": "__SECRET_ARN__:ACRCLOUD_HOST::" },
        { "name": "ACRCLOUD_ACCESS_KEY",       "valueFrom": "__SECRET_ARN__:ACRCLOUD_ACCESS_KEY::" },
        { "name": "ACRCLOUD_ACCESS_SECRET",    "valueFrom": "__SECRET_ARN__:ACRCLOUD_ACCESS_SECRET::" },
        { "name": "GOOGLE_API_KEY",            "valueFrom": "__SECRET_ARN__:GOOGLE_API_KEY::" },
        { "name": "YOUTUBE_API_KEY",           "valueFrom": "__SECRET_ARN__:YOUTUBE_API_KEY::" },
        { "name": "GOOGLE_CREDENTIALS_JSON",   "valueFrom": "__SECRET_ARN__:GOOGLE_CREDENTIALS_JSON::" },
        { "name": "SUPABASE_URL",              "valueFrom": "__SECRET_ARN__:SUPABASE_URL::" },
        { "name": "SUPABASE_SERVICE_ROLE_KEY", "valueFrom": "__SECRET_ARN__:SUPABASE_SERVICE_ROLE_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/natam/dev/worker",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
