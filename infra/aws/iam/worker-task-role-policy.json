{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploads",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::lavcca-dev-customer-uploads/uploads/*"
    },
    {
      "Sid": "WriteAiOutput",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::lavcca-dev-datalake/ai-output/*"
    },
    {
      "Sid": "TranscribeFallbackAudio",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::lavcca-dev-customer-uploads/transcribe-tmp/*"
    },
    {
      "Sid": "TranscribeFallbackJobs",
      "Effect": "Allow",
      "Action": [
        "transcribe:StartTranscriptionJob",
        "transcribe:GetTranscriptionJob",
        "transcribe:DeleteTranscriptionJob"
      ],
      "Resource": "arn:aws:transcribe:ap-northeast-2:__ACCOUNT_ID__:transcription-job/lavcca-asr-*"
    },
    {
      "Sid": "CopyrightRekognition",
      "Effect": "Allow",
      "Action": "rekognition:DetectLabels",
      "Resource": "*"
    }
  ]
}
