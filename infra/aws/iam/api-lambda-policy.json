{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SignUploadsAndCheck",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/uploads/*"
    },
    {
      "Sid": "SignReportDownloads",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__BUCKET__/reports/*"
    },
    {
      "Sid": "ListReports",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": "reports/*" } }
    },
    {
      "Sid": "Enqueue",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-northeast-2:__ACCOUNT_ID__:natam-dev-jobs"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-northeast-2:__ACCOUNT_ID__:log-group:/aws/lambda/natam-dev-api:*"
    }
  ]
}
