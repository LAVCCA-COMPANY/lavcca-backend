# 컨테이너 이미지에서 뺄 것. 빌드 컨텍스트 = apps/worker/
# (copyright_detector/.dockerignore 는 그 폴더를 컨텍스트로 쓸 때만 적용되므로 여기에도 같은 항목을 둔다)

# 비밀값 — 실행 시 Secrets Manager/환경변수로 주입
**/.env
**/*.env
!**/.env.example
**/*credentials*.json
**/*.pem
**/*.key

# 로컬 DB
**/*.sqlite
**/*.sqlite.bak*
**/*.sqlite3

# 캐시·가상환경
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/
.pytest_cache/
graphify-out/

# 실행 산출물·로컬 데이터 (작업별 입출력은 S3 로)
reports/
logs/
downloads/
samples/
transcripts/
casedb/          # 사례 인덱스는 이미지에 넣지 않고 시작 시 S3 에서 받는다(T2에서 구현)
copyright_detector/temp/
copyright_detector/results/
copyright_detector/downloads/

# 오프라인 작업용 (서비스 실행에 불필요)
tools/
data/
docs/
tests/
templates/       # 로컬 Flask(app.py) 화면 — 워커 이미지에는 불필요(루트 templates/ 에서 옮겨 옴)
_deprecated/
copyright_detector/font_legacy/      # 폰트 감지(비활성, 재개발 예정)
copyright_detector/models/font_classifier*

# 학습 연습 산출물 (tools/sagemaker/train.py)
out/

# ai 저장소 메타 파일(빌드 때 엔진을 겹쳐 놓으면서 따라온다) — 이미지에 불필요
README.md
AGENTS.md
CLAUDE.md
.claude/
.gitignore
requirements-dev.in
requirements-dev.txt
ai-engine.ref
.env.example
