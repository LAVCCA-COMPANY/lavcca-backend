# Copy this file to .env and fill in your own values. Never commit .env.

GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional (Clova NEST ASR) - leave blank to fall back to Gemini
CLOVA_INVOKE_URL=
CLOVA_SECRET_KEY=

# 뉴스 트렌드 가중치(apps/worker/trend_signals.py, 준비 단계): off(기본) | shadow
TREND_MODE=off

# Gemini 장애 대응(mvp_ver_1_9_2.py): 같은 모델 재시도 → 대체 모델 → (전사만) AWS Transcribe → 로컬 Whisper
# GEN_MODEL_FALLBACK 을 비우면 대체 모델을 쓰지 않는다
GEN_MODEL_FALLBACK=models/gemini-3.6-flash
GEMINI_RETRIES=4
# aws 로 두고 AWS_TRANSCRIBE_S3=s3://버킷/transcribe-tmp/ 를 주면 Transcribe 폴백(AWS 자격증명 필요)
TRANSCRIBE_FALLBACK=
AWS_TRANSCRIBE_S3=
