# Copy this file to .env and fill in your own values. Never commit .env.

GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional (Clova NEST ASR) - leave blank to fall back to Gemini
CLOVA_INVOKE_URL=
CLOVA_SECRET_KEY=

# ── Docker (docker compose 의 env_file) ──────────────────────────────
# 컨테이너에서는 이 파일의 값이 환경변수로 들어가고, 저작권 탐지기 서브프로세스도 그대로 물려받는다.
# 저작권 탐지기 키(ACRCLOUD_*, AUDD_API_TOKEN, GOOGLE_API_KEY, YOUTUBE_API_KEY, SERPAPI_KEY 등)도
# 필요하면 여기에 넣는다 (목록: mvp 1_9_3/copyright_detector/.env.example).
# 아래는 안전한 기본값 — 과금·외부 전송이 생기므로 동의한 경우에만 바꾼다.
TRANSCRIBE_ENGINE=gemini
USE_REKOGNITION=false
YANDEX_PUBLIC_UPLOAD_ENABLED=false
NATAM_MAX_CONCURRENT_JOBS=2
